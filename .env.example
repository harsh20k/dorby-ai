# OpenRouter (DeepSeek for synth generation / judge)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Defaults (override if you want different OpenRouter models)
# SYNTH_GENERATE_MODEL=deepseek/deepseek-v4-pro
# SYNTH_JUDGE_MODEL=google/gemini-3.1-flash-lite

# Optional LangSmith tracing + Prompt Hub
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=dorby-synth
#
# Prompt Hub (prefer hub over local synth_pipeline/prompts/*.md):
# LANGSMITH_PROMPT_OWNER=your-handle
# LANGSMITH_PROMPT_TAG=latest
# Or pin full identifiers (commit hash or tag):
# SYNTH_PROMPT_GENERATE_POS=your-handle/synth-generate-pos:latest
# SYNTH_PROMPT_GENERATE_NEG=your-handle/synth-generate-neg:latest
# SYNTH_PROMPT_JUDGE=your-handle/synth-judge:v2  # quality-only schema (polarity fix)
# Fallback label when hub is unused: SYNTH_PROMPT_VERSION=v1
#
# Push local md → hub (once):
#   python -m synth_pipeline.push_prompts --owner your-handle --tag v1
# Judge polarity fix (quality-only; keep generators on v1):
#   python -m synth_pipeline.push_prompts --owner your-handle --role judge --tag v2

# Voyage baseline eval (unrelated to synth)
# VOYAGE_API_KEY=pa-...
